{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lambda configuration",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "functions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "if": {
          "anyOf": [
            {
              "required": [
                "artifact"
              ]
            },
            {
              "required": [
                "log_retention_days"
              ]
            },
            {
              "required": [
                "planning_dependencies"
              ]
            }
          ]
        },
        "then": {
          "oneOf": [
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Lambda declaration v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime",
                "handler",
                "memory_size",
                "timeout",
                "log_retention_days",
                "artifact"
              ],
              "properties": {
                "runtime": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.]+$"
                },
                "handler": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
                },
                "memory_size": {
                  "type": "integer",
                  "minimum": 128,
                  "maximum": 10240
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 900
                },
                "log_retention_days": {
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    14,
                    30,
                    60,
                    90,
                    120,
                    150,
                    180,
                    365,
                    400,
                    545,
                    731,
                    1096,
                    1827,
                    2192,
                    2557,
                    2922,
                    3288,
                    3653
                  ]
                },
                "environment": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_]+$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "artifact": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "s3_bucket",
                    "s3_key",
                    "s3_object_version",
                    "source_code_hash"
                  ],
                  "properties": {
                    "s3_bucket": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
                    },
                    "s3_key": {
                      "type": "string",
                      "pattern": "^(?!.*(?:^|/)empty\\.zip$).+\\.zip$"
                    },
                    "s3_object_version": {
                      "type": "string",
                      "minLength": 1,
                      "not": {
                        "enum": [
                          "null",
                          "latest"
                        ]
                      }
                    },
                    "source_code_hash": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9+/]{43}=$"
                    }
                  }
                },
                "src_type": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "src_nickname": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "vpc_nickname": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                }
              }
            },
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Incomplete Lambda planning declaration",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime",
                "handler",
                "memory_size",
                "timeout",
                "log_retention_days",
                "artifact",
                "planning_dependencies"
              ],
              "properties": {
                "runtime": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.]+$"
                },
                "handler": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
                },
                "memory_size": {
                  "type": "integer",
                  "minimum": 128,
                  "maximum": 10240
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 900
                },
                "log_retention_days": {
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    14,
                    30,
                    60,
                    90,
                    120,
                    150,
                    180,
                    365,
                    400,
                    545,
                    731,
                    1096,
                    1827,
                    2192,
                    2557,
                    2922,
                    3288,
                    3653
                  ]
                },
                "environment": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_]+$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "artifact": {
                  "type": "null"
                },
                "src_type": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "src_nickname": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "vpc_nickname": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "planning_dependencies": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "artifact_publication",
                      "trusted_principal"
                    ]
                  },
                  "contains": {
                    "const": "artifact_publication"
                  }
                }
              }
            }
          ]
        },
        "else": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "handler": {
              "type": "string",
              "minLength": 1
            },
            "memory_size": {
              "type": "integer",
              "minimum": 128,
              "maximum": 10240
            },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            },
            "src_type": {
              "type": "string",
              "minLength": 1
            },
            "src_nickname": {
              "type": "string",
              "minLength": 1
            },
            "vpc_nickname": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "functions"
  ],
  "additionalProperties": false
}

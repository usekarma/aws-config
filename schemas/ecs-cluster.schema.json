{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ecs-cluster configuration",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "vpc_nickname": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "enable_execute_command": {
      "type": "boolean"
    },
    "exec_logging": {
      "type": "string",
      "minLength": 1
    },
    "create_log_group": {
      "type": "boolean"
    },
    "log_retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "enable_container_insights": {
      "type": "boolean"
    },
    "capacity_providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_capacity_strategy": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cluster_name": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "vpc_nickname"
  ],
  "additionalProperties": false
}

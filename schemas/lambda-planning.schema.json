{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incomplete Lambda planning declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "handler",
    "memory_size",
    "timeout",
    "log_retention_days",
    "artifact",
    "planning_dependencies"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.]+$"
    },
    "handler": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "memory_size": {
      "type": "integer",
      "minimum": 128,
      "maximum": 10240
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "log_retention_days": {
      "enum": [
        1,
        3,
        5,
        7,
        14,
        30,
        60,
        90,
        120,
        150,
        180,
        365,
        400,
        545,
        731,
        1096,
        1827,
        2192,
        2557,
        2922,
        3288,
        3653
      ]
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "null"
    },
    "src_type": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "src_nickname": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "vpc_nickname": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "planning_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "artifact_publication",
          "trusted_principal"
        ]
      },
      "contains": {
        "const": "artifact_publication"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vpc configuration",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "cidr": {
      "type": "string",
      "minLength": 1
    },
    "dhcp_domain_name": {
      "type": "string",
      "minLength": 1
    },
    "az_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "enable_ssm_endpoints": {
      "type": "boolean"
    },
    "single_nat_gateway": {
      "type": "boolean"
    },
    "default_sg_allow_self": {
      "type": "boolean"
    },
    "default_sg_extra_ingress_cidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "cidr"
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dhcp_domain_name_servers": {
      "description": "Optional implementation input; type not constrained yet. Review component code."
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [],
  "additionalProperties": false
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "iot-digital-twin sandbox configuration",
    "type": "object",
    "minProperties": 1,
    "properties": {
        "project": {
            "type": "string",
            "minLength": 1
        },
        "region": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]+-[0-9]$",
            "minLength": 1
        },
        "device_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "thing_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "mqtt_topic": {
            "type": "string",
            "pattern": "^devices/[a-z0-9-]+/telemetry$",
            "minLength": 1
        },
        "iot_rule_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "ingest_lambda_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "latest_state_table_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "twinmaker_workspace_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "twinmaker_entity_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "twinmaker_component_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "twinmaker_component_type": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "telemetry_rate_hz": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1
        },
        "offline_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
        },
        "max_clock_skew_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
        },
        "cloudwatch_log_retention_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3653
        },
        "device_certificate_authoritative": {
            "type": "boolean"
        },
        "device_id_is_data_only": {
            "type": "boolean"
        },
        "reject_device_authored_offline": {
            "type": "boolean"
        },
        "connectivity_state_server_derived": {
            "type": "boolean"
        },
        "server_replay_and_stale_enforcement": {
            "type": "boolean"
        },
        "max_retry_attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
        },
        "least_privilege_iam": {
            "type": "boolean"
        },
        "no_broad_permission_fallback": {
            "type": "boolean"
        },
        "tags": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "required": [
        "project",
        "region",
        "device_id",
        "thing_name",
        "mqtt_topic",
        "iot_rule_name",
        "ingest_lambda_name",
        "latest_state_table_name",
        "twinmaker_workspace_name",
        "twinmaker_entity_name",
        "twinmaker_component_name",
        "twinmaker_component_type",
        "telemetry_rate_hz",
        "offline_timeout_seconds",
        "max_clock_skew_seconds",
        "cloudwatch_log_retention_days",
        "device_certificate_authoritative",
        "device_id_is_data_only",
        "reject_device_authored_offline",
        "connectivity_state_server_derived",
        "server_replay_and_stale_enforcement",
        "max_retry_attempts",
        "least_privilege_iam",
        "no_broad_permission_fallback"
    ],
    "additionalProperties": false
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "route53-zone configuration",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "zone_name": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "type": "string",
      "minLength": 1
    },
    "root_records": {
      "type": "object"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "zone_name"
  ],
  "additionalProperties": false
}
